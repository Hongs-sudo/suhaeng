rules_version = '2';
// 수행평가 관리 앱 보안 규칙 — Firebase 콘솔 > Firestore > 규칙 에 그대로 붙여넣고 '게시'
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    // 원장님 계정 (config.js 의 ownerEmails 와 같게)
    function isOwner() { return signedIn() && myEmail() in ['ilmvm66@gmail.com']; }
    function tdoc() { return /databases/$(db)/documents/teachers/$(myEmail()); }
    function isTeacher() { return isOwner() || (signedIn() && exists(tdoc()) && get(tdoc()).data.active == true); }
    function isAdmin() { return isOwner() || (isTeacher() && get(tdoc()).data.role == 'admin'); }

    // 공통: 선생님 계정
    match /teachers/{em} {
      allow read: if isTeacher() || (signedIn() && em == myEmail());
      allow write: if isAdmin();
    }
    // 공통: 학생 명단
    match /students/{id} {
      allow read, create, update: if isTeacher();
      allow delete: if isAdmin();
    }
    // 부모님 공유 리포트: 링크(문서 ID)를 아는 사람만 한 건씩 열람
    match /programs/{pid}/reports/{token} {
      allow get: if true;
      allow list: if isTeacher();
      allow write: if isTeacher();
    }
    // 프로그램 기록 (회차 점수, 분석, 스캔, 의견 초안)
    match /programs/{pid}/{col}/{id} {
      allow read, write: if isTeacher();
    }
  }
}
